/* Modern admin-dashboard style for the Offline Inventory Management System.
   Palette: dark slate sidebar, indigo accent, light content area, white cards. */

* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    color: #1e293b;
}

QMainWindow, QWidget#ContentArea {
    background-color: #f1f5f9;
}

/* ---------- Sidebar ---------- */

QWidget#Sidebar {
    background-color: #1e2536;
}

QLabel#BrandLabel {
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    padding: 22px 20px 18px 20px;
}

QListWidget#NavList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px 10px;
}

QListWidget#NavList::item {
    color: #cbd5e1;
    padding: 10px 14px;
    margin: 2px 0px;
    border-radius: 8px;
}

QListWidget#NavList::item:hover {
    background-color: #2a3348;
    color: #ffffff;
}

QListWidget#NavList::item:selected {
    background-color: #4f46e5;
    color: #ffffff;
}

/* ---------- Header bar ---------- */

QWidget#HeaderBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

QLabel#PageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #0f172a;
    padding: 16px 24px;
}

/* ---------- Cards / pages ---------- */

QWidget#Card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

/* ---------- Buttons ---------- */

QPushButton {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 16px;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #eef2ff;
}

QPushButton#PrimaryButton {
    background-color: #4f46e5;
    color: #ffffff;
    border: 1px solid #4f46e5;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #4338ca;
    border-color: #4338ca;
}

QPushButton#PrimaryButton:pressed {
    background-color: #3730a3;
}

/* ---------- Inputs ---------- */

QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #4f46e5;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #4f46e5;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

/* ---------- Tables ---------- */

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    gridline-color: #e2e8f0;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    selection-background-color: #eef2ff;
    selection-color: #1e293b;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    font-weight: 600;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
}

QTableWidget::item {
    padding: 4px;
}

/* ---------- Misc ---------- */

QCheckBox {
    spacing: 8px;
}

QDialog {
    background-color: #ffffff;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
